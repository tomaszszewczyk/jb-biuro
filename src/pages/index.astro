---
import About from "../components/About.astro";
import CheckIcon from "../components/CheckIcon.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import Offer from "../components/Offer.astro";
import Location from "../components/Location.astro";
import "../styles/global.css";
import Pricing from "../components/Pricing.astro";
---

<!-- personality: professional, trustworthy -->
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Biuro Rachunkowe Joanna Bączar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="mx-auto font-sans">
    <Nav />
    <Header />
    <hr class="text-gray-300" />

    <main>
      <Offer />
      <hr class="text-gray-300" />
      <About />
      <hr class="text-gray-300" />
      <Location />
      <hr class="text-gray-300" />
      <Pricing />
      <hr class="text-gray-300" />

      <section id="kontakt">
        <h2>Porozmawiajmy o księgowości Twojej firmy</h2>
        <p>
          Szukasz biura rachunkowego lub planujesz zmianę dotychczasowej obsługi
          księgowej? Opisz krótko swoją firmę i zakres potrzebnych usług.
          Skontaktujemy się z Tobą, aby omówić możliwości współpracy.
        </p>

        <form>
          <p>
            <label for="email">Adres e-mail</label>
            <input id="email" name="email" type="email" required />
          </p>
          <p>
            <label for="phone">Numer telefonu (opcjonalnie)</label>
            <input id="phone" name="phone" type="tel" />
          </p>
          <p>
            <label for="message">Wiadomość (opcjonalnie)</label>
            <textarea id="message" name="message"></textarea>
          </p>
          <p>
            <button type="submit">Wyślij zapytanie</button>
          </p>
        </form>

        <p>Możesz również skontaktować się z nami bezpośrednio.</p>
        <p>
          Telefon:
          <a href="tel:+48693368459">693 368 459</a>
        </p>
        <p>
          Telefon stacjonarny:
          <a href="tel:+48748577566">74 857 75 66</a>
        </p>
        <p>
          E-mail:
          <a href="mailto:ksiegowosctwoja@wp.pl">ksiegowosctwoja@wp.pl</a>
        </p>
        <p>
          Adres biura:<br />
          ul. Mieszka I 17A/1<br />
          58-100 Świdnica
        </p>
      </section>
    </main>

    <footer>
      <p><strong>Biuro Rachunkowe Joanna Bączar sp. z o.o.</strong></p>
      <p>
        ul. Mieszka I 17A/1<br />
        58-100 Świdnica
      </p>

      <p><strong>Kontakt</strong></p>
      <p>
        <a href="tel:+48748577566">74 857 75 66</a><br />
        <a href="tel:+48693368459">693 368 459</a><br />
