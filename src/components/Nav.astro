---
import DesktopNav from "./DesktopNav.astro";
import MenuIcon from "./icons/MenuIcon.astro";
import MobileNav from "./MobileNav.astro";

const items = [
  { href: "#oferta", label: "Oferta" },
  { href: "#o-nas", label: "O nas" },
  { href: "#cennik", label: "Cennik" },
  { href: "#kontakt", label: "Kontakt" },
];
---

<header class="sticky top-0 z-10 bg-white flex justify-between p-4">
  <div class="text-gray-800">Biuro Rachunkowe Joanna Bączar</div>
  <button
    type="button"
    class="relative z-20 md:hidden"
    aria-expanded="false"
    aria-controls="site-nav"
    data-nav-toggle
  >
    <MenuIcon class="text-gray-800" />
  </button>
  <MobileNav items={items} />
  <DesktopNav items={items} />
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.querySelector("[data-nav]");

  if (toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
    toggle.addEventListener("click", () => {
      const collapsed = nav.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!collapsed));
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        nav.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
