---
import DesktopNav from "./DesktopNav.astro";
import MenuIcon from "./icons/MenuIcon.astro";
import MobileNav from "./MobileNav.astro";

const items = [
  { href: "#oferta", label: "Oferta" },
  { href: "#o-nas", label: "O\u00A0nas" },
  { href: "#cennik", label: "Cennik" },
  { href: "#kontakt", label: "Kontakt" },
];
---

<header class="sticky top-0 z-10 shadow-sm">
  <div
    class="absolute inset-0 -z-10 bg-white/70 backdrop-blur-xl"
    aria-hidden="true"
  >
  </div>
  <div class="w-full h-2 bg-sky-600"></div>
  <div class="flex justify-between p-4 items-center max-w-5xl mx-auto">
    <div class="flex gap-2">
      <img src="logo.svg" width="24" alt="" />
      <div class="text-gray-800 font-medium">
        Biuro Rachunkowe Joanna Bączar
      </div>
    </div>
    <button
      type="button"
      class="relative z-20 md:hidden"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <MenuIcon class="text-gray-800" />
    </button>

    <MobileNav items={items} />
    <DesktopNav items={items} />
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.querySelector("[data-nav]");

  if (toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
    toggle.addEventListener("click", () => {
      const collapsed = nav.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!collapsed));
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        nav.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
