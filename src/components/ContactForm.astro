---
import ArrowRight from "./icons/ArrowRight.astro";

const content = {
  title: "Porozmawiajmy o księgowości Twojej firmy",
  intro: [
    "Szukasz biura rachunkowego lub planujesz zmianę dotychczasowej obsługi księgowej?",
    "Opisz krótko swoją firmę i zakres potrzebnych usług. Skontaktujemy się z Tobą, aby omówić możliwości współpracy.",
  ],
  fields: {
    email: { label: "Adres e-mail", placeholder: "mail@poczta.pl" },
    phone: { label: "Telefon", placeholder: "+48 ..." },
    message: { label: "Wiadomość" },
  },
  submit: "Wyślij zapytanie",
  directContact: "Możesz również skontaktować się z nami bezpośrednio.",
  contacts: {
    mobile: { href: "tel:+48693368459", label: "+48 693 368 459" },
    phone: { href: "tel:+48748577566", label: "+48 74 857 75 66" },
    email: {
      href: "mailto:ksiegowosctwoja@wp.pl",
      label: "ksiegowosctwoja@wp.pl",
    },
    address: ["ul. Mieszka I 17A/1", "58-100 Świdnica"],
  },
};
---

<section id="kontakt" class="p-4 md:p-8 bg-gray-50 max-w-5xl mx-auto shadow-sm">
  <h2 class="font-semibold text-2xl md:text-3xl font-serif text-gray-700">
    {content.title}
  </h2>

  <div class="md:flex gap-12 items-center">
    <div class="flex-1">
      {
        content.intro
          .slice(0, 1)
          .map((paragraph) => (
            <p class="py-2 font-light text-gray-700 md:text-lg max-w-xl">
              {paragraph}
            </p>
          ))
      }
      {
        content.intro
          .slice(1, 2)
          .map((paragraph) => (
            <p class="py-2 font-light md:text-sm text-gray-700">{paragraph}</p>
          ))
      }

      <p class="py-4 font-light text-gray-700 md:text-sm">
        {content.directContact}
      </p>

      <p class="flex gap-4 items-center pb-2 pl-2">
        <a href={content.contacts.mobile.href} class="text-xl text-gray-700"
          >{content.contacts.mobile.label}</a
        >
      </p>
      <p class="flex gap-4 items-center pb-2 pl-2">
        <a href={content.contacts.phone.href} class="text-xl text-gray-700"
          >{content.contacts.phone.label}</a
        >
      </p>
      <p class="flex gap-4 items-center pb-2 pl-2">
        <a href={content.contacts.email.href} class="text-xl text-gray-700"
          >{content.contacts.email.label}</a
        >
      </p>
    </div>

    <div class="flex-1">
      <form
        id="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="my-4 md:mt-6 rounded-xs bg-white shadow-sm overflow-clip"
      >
        <input
          type="hidden"
          name="access_key"
          value="2c5d297a-7f50-4b7e-9a13-e6addcbc2905"
        />
        <input
          type="hidden"
          name="subject"
          value="Nowe zapytanie ze strony jb-biuro.pl"
        />
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          tabindex="-1"
          aria-hidden="true"
        />
        <div class="flex flex-col gap-4 p-6">
          <p class="flex flex-col gap-2">
            <label for="email" class="text-sm text-gray-500 pl-2"
              >{content.fields.email.label}</label
            >

            <input
              id="email"
              name="email"
              type="email"
              aria-describedby="contact-requirement"
              class="bg-white rounded-sm p-2 text-sm text-gray-700 border border-gray-100"
              placeholder={content.fields.email.placeholder}
            />
          </p>

          <p class="flex flex-col gap-1 pb-1">
            <label for="phone" class="text-sm text-gray-500 pl-2"
              >{content.fields.phone.label}</label
            >
            <input
              id="phone"
              name="phone"
              type="tel"
              aria-describedby="contact-requirement"
              class="bg-white rounded-sm p-2 text-sm text-gray-700 border border-gray-100"
              placeholder={content.fields.phone.placeholder}
            />
          </p>

          <p class="flex flex-col gap-1 pb-1">
            <label for="message" class="text-sm text-gray-500 pl-2"
              >{content.fields.message.label}</label
            >
            <textarea
              id="message"
              name="message"
              class="bg-white rounded-sm p-2 text-sm text-gray-700 border border-gray-100"
              placeholder="Proszę o kontakt w sprawie..."></textarea>
          </p>
        </div>

        <p class="flex flex-col gap-1">
          <button
            type="submit"
            class="font-sans py-3 px-6 bg-sky-700 text-white text-lg flex gap-4 items-center justify-center disabled:opacity-60 disabled:cursor-wait"
          >
            <span data-submit-label>{content.submit}</span>
            <ArrowRight class="text-white-900" />
          </button>
        </p>
        <p
          data-form-status
          role="status"
          aria-live="polite"
          aria-atomic="true"
          class="px-6 py-4 empty:hidden text-sm font-medium text-white bg-green-700"
        >
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const submitButton = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );
  const submitLabel = form?.querySelector<HTMLElement>("[data-submit-label]");
  const status = form?.querySelector<HTMLElement>("[data-form-status]");
  const email = form?.querySelector<HTMLInputElement>('[name="email"]');
  const phone = form?.querySelector<HTMLInputElement>('[name="phone"]');

  if (form && submitButton && submitLabel && status && email && phone) {
    const clearContactError = () => email.setCustomValidity("");
    email.addEventListener("input", clearContactError);
    phone.addEventListener("input", clearContactError);
    form.addEventListener("reset", clearContactError);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitButton.disabled) return;

      email.setCustomValidity(
        email.value.trim() || phone.value.trim()
          ? ""
          : "Podaj adres e-mail lub numer telefonu.",
      );
      if (!form.reportValidity()) return;

      const formData = new FormData(form);
      const originalText = submitLabel.textContent;
      submitLabel.textContent = "Wysyłanie…";
      submitButton.disabled = true;
      form.setAttribute("aria-busy", "true");
      status.textContent = "";
      status.classList.remove("text-red-700");
      status.classList.add("text-gray-700");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
          signal: AbortSignal.timeout(20000),
        });
        const data = await response.json();

        if (!response.ok || data.success !== true) {
          throw new Error("Submission failed");
        }

        form.reset();

        status.classList.remove("bg-red-800");
        status.classList.add("bg-green-700");
        status.textContent =
          "Dziękujemy! Twoja wiadomość została wysłana. Skontaktujemy się z Tobą w sprawie współpracy.";
      } catch {
        status.classList.remove("bg-green-700");
        status.classList.add("bg-red-800");
        status.textContent =
          "Nie udało się potwierdzić wysłania wiadomości. Spróbuj ponownie za chwilę lub skontaktuj się z nami telefonicznie albo e-mailem.";
      } finally {
        submitLabel.textContent = originalText;
        submitButton.disabled = false;
        form.removeAttribute("aria-busy");
      }
    });
  }
</script>
