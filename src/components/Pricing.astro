---
import ArrowRight from "./icons/ArrowRight.astro";

const content = {
  title: "Cennik usług księgowych",
  description:
    "Poznaj orientacyjne koszty obsługi księgowej. Cena zależy od liczby dokumentów i\u00A0zakresu świadczonych usług.",
  fullAccounting: {
    title: "Pełna księgowość",
    slug: "netto / miesiąc",
    tiers: [
      {
        label: "Do 10\u00A0dokumentów",
        price: "800\u00A0zł",
      },
      {
        label: "11-30\u00A0dokumentów",
        price: "1\u00A0500\u00A0zł",
      },
      {
        label: "31-50\u00A0dokumentów",
        price: "2\u00A0000\u00A0zł",
      },
    ],
    custom: {
      label: "Powyżej 50\u00A0dokumentów",
      price: "Wycena indywidualna",
    },
    note: "Do podanych cen należy doliczyć podatek VAT.",
  },
  payroll: {
    title: "Kadry i\u00A0płace",
    description:
      "Prowadzenie akt osobowych, sporządzanie list płac i\u00A0obsługa rozliczeń ZUS.",
    price: "70\u00A0zł",
    slug: "netto / pracownik / miesiąc",
  },
  customQuote: {
    title: "Potrzebujesz szerszego zakresu usług?",
    description:
      "Jeżeli Twoja firma wymaga niestandardowej obsługi lub dodatkowych rozliczeń, skontaktuj się z\u00A0nami. Przygotujemy wycenę uwzględniającą zakres Twoich potrzeb.",
    action: {
      href: "#kontakt",
      label: "Poproś o\u00A0wycenę",
    },
  },
};
---

<section id="cennik" class="px-4 py-8">
  <h2 class="font-semibold text-2xl font-serif text-gray-700">
    {content.title}
  </h2>
  <p class="pt-2 pb-6 font-light text-gray-700">
    {content.description}
  </p>

  <h3 class="font-serif font-semibold text-xl text-gray-700 pb-2">
    {content.fullAccounting.title}
  </h3>

  {
    content.fullAccounting.tiers.map((tier) => (
      <div class="border border-gray-300 rounded-sm p-4 mb-4">
        <p class="text-sm pb-2 text-gray-600">{tier.label}</p>
        <div class="flex items-baseline gap-2">
          <p class="font-serif text-3xl text-gray-800">{tier.price}</p>
          <p class="font-serif text-xl text-gray-800">
            {content.fullAccounting.slug}
          </p>
        </div>
      </div>
    ))
  }

  <div class="border border-gray-300 rounded-sm p-4 mb-8">
    <p class="text-sm pb-2 text-gray-600">
      {content.fullAccounting.custom.label}
    </p>
    <p class="font-serif text-2xl text-gray-800 font-medium">
      {content.fullAccounting.custom.price}
    </p>
  </div>

  <h3 class="font-serif font-semibold text-xl text-gray-700 pb-2">
    {content.payroll.title}
  </h3>

  <div class="border border-gray-300 rounded-sm p-4 mb-4">
    <p class="text-sm pb-2 text-gray-600">{content.payroll.description}</p>
    <div class="flex items-baseline gap-2">
      <p class="font-serif text-3xl text-gray-800">{content.payroll.price}</p>
      <p class="font-serif text-xl text-gray-800">
        {content.payroll.slug}
      </p>
    </div>
  </div>

  <p class="text-xs pb-4 pt-2 text-gray-600 mb-6">
    {content.fullAccounting.note}
  </p>

  <h3 class="font-serif font-semibold text-xl text-gray-700 pb-2">
    {content.customQuote.title}
  </h3>
  <p class="pt-2 pb-8 font-light text-gray-700">
    {content.customQuote.description}
  </p>

  <p class="pb-4">
    <a
      href={content.customQuote.action.href}
      class="font-sans py-3 px-6 border-gray-800 bg-gray-800 text-white border rounded-xs text-lg inline-flex gap-4 items-center"
    >
      {content.customQuote.action.label}
      <ArrowRight class="text-white" />
    </a>
  </p>
</section>
