---
import CheckIcon from "./icons/CheckIcon.astro";

const content = {
  title: "Oferta księgowa dla Twojej firmy",
  description:
    "Od bieżących rozliczeń po pełną sprawozdawczość finansową. Zapewniamy obsługę księgową dopasowaną do formy prowadzonej działalności i\u00A0zakresu obowiązków Twojej firmy.",
  services: [
    {
      title: "Pełna księgowość",
      description:
        "Prowadzimy księgi rachunkowe i\u00A0przygotowujemy sprawozdania finansowe. Zajmujemy się zarówno organizacją księgowości, jak i\u00A0jej bieżącą obsługą.",
      items: [
        "Otwarcie i\u00A0prowadzenie ksiąg rachunkowych",
        "Opracowanie polityki rachunkowości i\u00A0planu kont",
        "Ewidencja kosztów na kontach zespołu 4 i\u00A05, w\u00A0tym dla firm produkcyjnych",
        "Sporządzanie sprawozdań finansowych: bilansu, rachunku zysków i\u00A0strat oraz rachunku przepływów pieniężnych",
        "Przygotowywanie zestawień rozrachunków, kapitałów i\u00A0wskaźników finansowych",
      ],
    },
    {
      title: "KPiR i ryczałt",
      description:
        "Obsługujemy przedsiębiorców prowadzących uproszczoną księgowość. Zajmujemy się bieżącą ewidencją przychodów i\u00A0kosztów oraz rozliczeniami podatkowymi.",
      items: [
        "Prowadzenie podatkowej księgi przychodów i\u00A0rozchodów (KPiR) oraz ewidencji przychodów dla ryczałtu",
        "Ewidencjonowanie i\u00A0weryfikacja dokumentów księgowych",
        "Obliczanie podatku dochodowego i\u00A0przygotowywanie rocznych deklaracji PIT",
        "Prowadzenie rejestrów VAT oraz sporządzanie i\u00A0wysyłanie wymaganych plików JPK",
        "Prowadzenie ewidencji środków trwałych oraz rozliczanie amortyzacji, jeśli dotyczy",
      ],
    },
    {
      title: "Kadry i płace",
      description:
        "Zajmujemy się dokumentacją pracowniczą, naliczaniem wynagrodzeń i\u00A0rozliczeniami z\u00A0ZUS. Prowadzimy kadry na bieżąco, od\u00A0zatrudnienia po\u00A0zakończenie współpracy.",
      items: [
        "Prowadzenie i\u00A0uzupełnianie akt osobowych pracowników",
        "Sporządzanie list płac na podstawie danych kadrowych",
        "Naliczanie wynagrodzeń oraz pozostałych składników płac",
        "Obsługa rozliczeń z\u00A0ZUS i\u00A0przygotowanie dokumentacji",
      ],
    },
    {
      title: "KSeF i JPK",
      description:
        "Pomagamy przygotować księgowość do\u00A0KSeF oraz obowiązków JPK. Dostosowujemy obieg dokumentów i\u00A0ewidencję do\u00A0zmieniających się wymogów sprawozdawczych.",
      items: [
        "Obsługa faktur wystawianych i\u00A0otrzymywanych w\u00A0KSeF",
        "Dostosowanie obiegu dokumentów księgowych do\u00A0KSeF",
        "Przygotowanie ksiąg do\u00A0raportów JPK-PD oraz JPK-ST",
        "Dostosowanie ewidencji do\u00A0wymaganych danych podatkowych",
      ],
    },
  ],
  grants: {
    title: "Rozliczanie dotacji",
    description:
      "Wspieramy przedsiębiorców w\u00A0rozliczaniu otrzymanych dotacji i\u00A0przygotowaniu związanej z\u00A0nimi dokumentacji księgowej.",
  },
};
---

<section
  id="oferta"
  class="px-4 md:px-8 py-8 bg-gray-50 shadow-sm max-w-5xl mx-auto"
>
  <h2 class="font-semibold text-2xl md:text-3xl font-serif text-gray-700">
    {content.title}
  </h2>
  <p class="py-2 font-light text-gray-700 max-w-xl">{content.description}</p>

  <div class="offer-grid mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-8">
    {
      content.services.map((service) => (
        <div class="rounded-xs bg-white overflow-clip shadow-md">
          <h3 class="offer-heading relative font-serif font-semibold text-xl text-gray-50 bg-sky-700 px-4 pt-4 pb-3">
            {service.title}
          </h3>
          <div class="px-4 py-3">
            <p class="py-2 text-gray-600 text-sm hyphens-auto">
              {service.description}
            </p>
            <ul class="flex flex-col gap-4 px-1 py-4">
              {service.items.map((item) => (
                <li class="flex gap-2">
                  <CheckIcon class="shrink-0 text-sky-700" />
                  <span class="text-sm pt-0.75 text-gray-600">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }

    <div class="rounded-xs bg-white overflow-clip shadow-md">
      <h3
        class="offer-heading relative font-serif font-semibold text-xl text-gray-50 bg-sky-700 px-4 pt-4 pb-3"
      >
        {content.grants.title}
      </h3>
      <p class="text-gray-600 text-sm p-4 hyphens-auto">
        {content.grants.description}
      </p>
    </div>
  </div>
</section>

<style>
  @media (min-width: 48rem) {
    .offer-grid > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc(50% - 0.5rem);
    }
  }

  .offer-heading::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgb(255 255 255 / 0.3);
    pointer-events: none;
    mask-image:
      linear-gradient(to right, transparent, 80%, black),
      url("../assets/bank-note.png");
    mask-repeat: no-repeat, repeat;
    mask-size:
      100% 100%,
      50px 10px;
    mask-composite: intersect;
  }
</style>
