---
import CheckIcon from "./icons/CheckIcon.astro";

const content = {
  title: "Oferta księgowa dla Twojej firmy",
  description:
    "Od bieżących rozliczeń po pełną sprawozdawczość finansową. Zapewniamy obsługę księgową dopasowaną do formy prowadzonej działalności i\u00A0zakresu obowiązków Twojej firmy.",
  services: [
    {
      title: "Pełna księgowość",
      description:
        "Prowadzimy księgi rachunkowe i\u00A0przygotowujemy sprawozdania finansowe. Zajmujemy się zarówno organizacją księgowości, jak i\u00A0jej bieżącą obsługą.",
      items: [
        "Otwarcie i\u00A0prowadzenie ksiąg rachunkowych",
        "Opracowanie polityki rachunkowości i\u00A0planu kont",
        "Ewidencja kosztów na kontach zespołu 4 i\u00A05, w\u00A0tym dla firm produkcyjnych",
        "Sporządzanie sprawozdań finansowych: bilansu, rachunku zysków i\u00A0strat oraz rachunku przepływów pieniężnych",
        "Przygotowywanie zestawień rozrachunków, kapitałów i\u00A0wskaźników finansowych",
      ],
    },
    {
      title: "KPiR i ryczałt",
      description:
        "Obsługujemy przedsiębiorców prowadzących uproszczoną księgowość. Zajmujemy się bieżącą ewidencją przychodów i\u00A0kosztów oraz rozliczeniami podatkowymi.",
      items: [
        "Prowadzenie podatkowej księgi przychodów i\u00A0rozchodów (KPiR) oraz ewidencji przychodów dla ryczałtu",
        "Ewidencjonowanie i\u00A0weryfikacja dokumentów księgowych",
        "Obliczanie podatku dochodowego i\u00A0przygotowywanie rocznych deklaracji PIT",
        "Prowadzenie rejestrów VAT oraz sporządzanie i\u00A0wysyłanie wymaganych plików JPK",
        "Prowadzenie ewidencji środków trwałych oraz rozliczanie amortyzacji, jeśli dotyczy",
      ],
    },
    {
      title: "Kadry i płace",
      description:
        "Zajmujemy się dokumentacją pracowniczą, naliczaniem wynagrodzeń oraz rozliczeniami z\u00A0ZUS.",
      items: [
        "Prowadzenie akt osobowych",
        "Sporządzanie list płac",
        "Naliczanie wynagrodzeń",
        "Obsługa rozliczeń i\u00A0dokumentacji ZUS",
      ],
    },
    {
      title: "KSeF i JPK",
      description:
        "Pomagamy firmom przygotować księgowość do zmieniających się obowiązków podatkowych i\u00A0sprawozdawczych, w\u00A0tym obsługi Krajowego Systemu e-Faktur.",
      items: [
        "Obsługa faktur w\u00A0KSeF",
        "Dostosowanie obiegu dokumentów do KSeF",
        "Przygotowanie ksiąg do raportowania JPK-PD i\u00A0JPK-ST, zgodnie z\u00A0obowiązkami danej firmy",
        "Dostosowanie ewidencji księgowej do wymaganych znaczników i\u00A0danych podatkowych",
      ],
    },
  ],
  grants: {
    title: "Rozliczanie dotacji",
    description:
      "Wspieramy przedsiębiorców w\u00A0rozliczaniu otrzymanych dotacji i\u00A0przygotowaniu związanej z\u00A0nimi dokumentacji księgowej.",
  },
};
---

<section id="oferta" class="px-4 py-8">
  <h2 class="font-semibold text-2xl font-serif text-gray-700">
    {content.title}
  </h2>
  <p class="py-2 font-light text-gray-700">{content.description}</p>

  {
    content.services.map((service) => (
      <div class="border border-gray-200 p-4 my-4 rounded-xs">
        <h3 class="font-serif font-semibold text-xl text-gray-700">
          {service.title}
        </h3>
        <p class="py-2 text-gray-600 text-sm">{service.description}</p>
        <ul class="flex flex-col gap-4 px-1 py-4">
          {service.items.map((item) => (
            <li class="flex gap-2">
              <CheckIcon class="shrink-0 text-gray-600" />
              <span class="text-sm pt-0.75 text-gray-600">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <div class="border border-gray-200 rounded-xs p-4 my-4">
    <h3 class="font-serif font-semibold text-xl text-gray-700">
      {content.grants.title}
    </h3>
    <p class="py-2 text-gray-600 text-sm">{content.grants.description}</p>
  </div>
</section>
