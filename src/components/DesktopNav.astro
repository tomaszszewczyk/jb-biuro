---
interface Props {
  items: { href: string; label: string }[];
}

const { items } = Astro.props as Props;
---

<nav class="hidden md:block" aria-label="Główne">
  <ul class="flex gap-8 text-sm">
    {
      items.map((item, index) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "hover:underline",
              index === items.length - 1 ? "font-semibold text-sky-700" : "",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
