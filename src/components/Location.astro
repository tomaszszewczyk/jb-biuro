---
import ArrowRight from "./icons/ArrowRight.astro";

const content = {
  title: "Twoja księgowość, niezależnie od lokalizacji",
  paragraphs: [
    "Nasze biuro mieści się w\u00A0Świdnicy, ale obsługujemy również firmy z\u00A0całej Polski.",
    "Oferujemy współpracę stacjonarną i\u00A0zdalną, korzystając z\u00A0nowoczesnego oprogramowania księgowego i\u00A0elektronicznego obiegu informacji. Dzięki temu możemy prowadzić księgowość Twojej firmy i\u00A0pozostawać w\u00A0bieżącym kontakcie, nawet jeśli nie znajdujesz się w\u00A0naszej okolicy.",
  ],
  action: {
    href: "#kontakt",
    label: "Zapytaj o\u00A0współpracę",
  },
};
---

<section class="px-4 py-8">
  <h2 class="font-semibold text-2xl font-serif text-gray-700">
    {content.title}
  </h2>
  <p class="py-2 font-light text-gray-700">{content.paragraphs[0]}</p>
  <p class="pt-2 pb-8 font-light text-gray-700">{content.paragraphs[1]}</p>
  <a
    href={content.action.href}
    class="font-sans py-3 px-6 border-gray-800 bg-gray-800 text-white border rounded-xs text-lg inline-flex gap-4 items-center"
  >
    {content.action.label}
    <ArrowRight class="text-white" />
  </a>
</section>
