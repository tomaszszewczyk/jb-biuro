---
import CheckIcon from "../components/icons/CheckIcon.astro";
import ArrowRight from "./icons/ArrowRight.astro";

const content = {
  title: "Księgowość dopasowana do potrzeb",
  title2: "Twojej firmy",
  description:
    "Prowadzimy pełną księgowość, KPiR i\u00A0ryczałt oraz zapewniamy obsługę kadr i\u00A0płac. Od prawie 30\u00A0lat wspieramy przedsiębiorców w\u00A0prowadzeniu księgowości i\u00A0realizacji obowiązków podatkowych.",
  actions: [
    { href: "#kontakt", label: "Zapytaj o ofertę" },
    { href: "#oferta", label: "Poznaj nasze usługi" },
  ],
  highlights: [
    "Prawie 30\u00A0lat doświadczenia",
    "Obsługa firm z\u00A0całej Polski",
    "Współpraca stacjonarna i\u00A0zdalna",
  ],
};
---

<header class="shadow-sm max-w-5xl mx-auto">
  <div class="bg-graph">
    <h1
      class="p-4 md:px-8 text-4xl font-semibold pb-3 font-serif text-gray-800 pt-16 max-w-xl md:pt-64 md:text-5xl"
    >
      {content.title}
      {" "}
      <span class="text-sky-700 font-bold underline">{content.title2}</span>
    </h1>
  </div>
  <div class="p-4 md:px-8 md:flex gap-4 md:pt-12">
    <div class="flex-1">
      <p class="pb-4 font-light text-gray-700">{content.description}</p>
      <p class="py-4 flex gap-4">
        <a
          class="font-sans py-3 px-6 bg-sky-700 text-white border rounded-xs text-lg flex gap-4 items-center"
          href={content.actions[0].href}
        >
          {content.actions[0].label}
          <ArrowRight class="text-white" />
        </a>
      </p>
    </div>
    <div class="flex-1">
      <ul class="py-6 md:py-0 pl-2 flex flex-col gap-6">
        {
          content.highlights.map((highlight) => (
            <li class="flex gap-4 items-center">
              <CheckIcon class="text-sky-800" />
              <span class="text-gray-600 text-lg border-b border-gray-400">
                {highlight}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<style>
  .bg-graph {
    position: relative;
    isolation: isolate;
  }

  .bg-graph::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url("../assets/graph-paper.svg");
    background-repeat: repeat;
    mask-image: radial-gradient(circle at bottom left, transparent 30%, black);
  }
</style>
