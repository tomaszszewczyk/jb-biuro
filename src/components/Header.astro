---
import CheckIcon from "../components/icons/CheckIcon.astro";

const content = {
  title: "Księgowość dopasowana do potrzeb Twojej firmy",
  description:
    "Prowadzimy pełną księgowość, KPiR i ryczałt oraz zapewniamy obsługę kadr i płac. Od prawie 30 lat wspieramy przedsiębiorców w prowadzeniu księgowości i realizacji obowiązków podatkowych.",
  actions: [
    { href: "#kontakt", label: "Zapytaj o ofertę" },
    { href: "#oferta", label: "Poznaj nasze usługi" },
  ],
  highlights: [
    "Prawie 30 lat doświadczenia",
    "Obsługa firm z całej Polski",
    "Współpraca stacjonarna i zdalna",
  ],
};
---

<header class="p-4">
  <h1 class="text-4xl font-bold pb-4">{content.title}</h1>
  <p class="pb-4">{content.description}</p>
  <p class="pb-4 flex gap-4">
    <a class="py-2 px-4 bg-gray-100" href={content.actions[0].href}>
      {content.actions[0].label}
    </a>
    <a
      class="py-2 px-4 border-gray-100 border-2"
      href={content.actions[1].href}
    >
      {content.actions[1].label}
    </a>
  </p>
  <ul class="py-4 pl-4 flex flex-col gap-4">
    {
      content.highlights.map((highlight) => (
        <li class="flex gap-2">
          <CheckIcon class="text-gray-500" />
          <span>{highlight}</span>
        </li>
      ))
    }
  </ul>
</header>
