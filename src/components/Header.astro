---
import CheckIcon from "../components/icons/CheckIcon.astro";
import ArrowRight from "./icons/ArrowRight.astro";

const content = {
  title: "Księgowość dopasowana do potrzeb Twojej firmy",
  description:
    "Prowadzimy pełną księgowość, KPiR i ryczałt oraz zapewniamy obsługę kadr i płac. Od prawie 30 lat wspieramy przedsiębiorców w prowadzeniu księgowości i realizacji obowiązków podatkowych.",
  actions: [
    { href: "#kontakt", label: "Zapytaj o ofertę" },
    { href: "#oferta", label: "Poznaj nasze usługi" },
  ],
  highlights: [
    "Prawie 30 lat doświadczenia",
    "Obsługa firm z całej Polski",
    "Współpraca stacjonarna i zdalna",
  ],
};
---

<header class="p-4 mb-2">
  <h1 class="text-4xl font-semibold pb-3 font-serif text-gray-800">
    {content.title}
  </h1>
  <p class="pb-4 font-light text-gray-700">{content.description}</p>
  <p class="py-4 flex gap-4">
    <a
      class="font-sans py-3 px-6 border-gray-800 bg-gray-800 text-white border rounded-xs text-lg flex gap-4 items-center"
      href={content.actions[0].href}
    >
      {content.actions[0].label}
      <ArrowRight class="text-white" />
    </a>
  </p>
  <ul class="py-6 pl-2 flex flex-col gap-6">
    {
      content.highlights.map((highlight) => (
        <li class="flex gap-4 items-center">
          <CheckIcon class="text-gray-600" />
          <span class="text-gray-700 text-lg border-b">{highlight}</span>
        </li>
      ))
    }
  </ul>
</header>
